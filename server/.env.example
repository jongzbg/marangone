# PostgreSQL connection string
# For Docker Compose (service name = db): postgresql://nexus:***@db:5432/nexus
# For local dev outside Docker: postgresql://nexus:***@localhost:5433/nexus
DATABASE_URL=

# Redis (BullMQ + Socket.io adapter)
# Docker: host=redis; Local: host=localhost, port=6380 (compose maps 6380→6379)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT signing secret — generate via: openssl rand -hex 32
# DO NOT commit the real value. Place it in .env (gitignored).
JWT_SECRET=

# Optional: token expiry (default 7d)
JWT_EXPIRES_IN=7d

# Frontend URL for CORS allowlist
FRONTEND_URL=http://localhost:3000

# Server port (default 3001)
PORT=3001
